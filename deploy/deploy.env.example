# Copy to deploy.env and fill in. deploy.env is gitignored.

# Image (single app container)
REGISTRY=ghcr.io/g-guglielmi/fleetscope
TAG=latest

# Timezone for scheduled jobs (NVD sync, email digest) and container clock
TZ=Europe/Rome

# Host port your reverse proxy forwards to (container listens on 8000)
APP_PORT=8080

# Dashboard admin + JWT signing. The container REFUSES TO START with default
# values (unless FS_DEV_MODE=true, which is for local development only).
# The bootstrap admin must change this password on first login.
FS_JWT_SECRET=change-me-long-random
FS_ADMIN_EMAIL=admin@yourmsp.example
FS_ADMIN_PASSWORD=change-me-strong

# Public URL of the dashboard, embedded in generated agent install commands.
FS_PUBLIC_URL=https://fleetscope.yourmsp.example

# Keys. Generate all three at once with:  python tools/sign/sign.py keygen
#  - FS_SECRETS_KEY    base64 32 bytes; encrypts stored credentials (AES-256-GCM).
#                      Unset = credential storage disabled. Back it up: without it
#                      the credentials in the database cannot be decrypted.
#  - FS_SIGNING_PUBKEY Ed25519 public key; agents pin it and verify every check
#                      module/release against it. The PRIVATE key goes ONLY into
#                      the GitHub Actions secret FS_SIGNING_KEY, never here.
FS_SECRETS_KEY=
FS_SIGNING_PUBKEY=

# Agent check-in cadence (seconds) and enrollment token lifetime.
FS_AGENT_CHECKIN_SECONDS=120
FS_ENROLLMENT_TTL_HOURS=24

# NVD auto-sync (optional API key raises the rate limit)
FS_NVD_SYNC_ENABLED=true
FS_NVD_API_KEY=

# Email digest (leave FS_SMTP_HOST empty to disable alerting)
FS_SMTP_HOST=
FS_SMTP_PORT=587
FS_SMTP_STARTTLS=true
FS_SMTP_USER=
FS_SMTP_PASSWORD=
FS_ALERT_FROM=fleetscope@yourmsp.example
FS_ALERT_TO=ops@yourmsp.example
