# Copy to deploy.env and fill in. deploy.env is gitignored.
# Registry / images
REGISTRY=ghcr.io/g-guglielmi/fleetscope
TAG=latest

# Postgres
POSTGRES_PASSWORD=change-me-strong

# Backend secrets (FS_ prefix maps to app settings)
FS_JWT_SECRET=change-me-long-random
FS_ADMIN_EMAIL=admin@yourmsp.example
FS_ADMIN_PASSWORD=change-me-strong

# NVD auto-sync (optional API key raises the rate limit)
FS_NVD_SYNC_ENABLED=true
FS_NVD_API_KEY=

# Email digest (leave FS_SMTP_HOST empty to disable alerting)
FS_SMTP_HOST=
FS_SMTP_PORT=587
FS_SMTP_STARTTLS=true
FS_SMTP_USER=
FS_SMTP_PASSWORD=
FS_ALERT_FROM=fleetscope@yourmsp.example
FS_ALERT_TO=ops@yourmsp.example
