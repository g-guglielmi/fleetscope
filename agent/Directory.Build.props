<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Pinned so local and CI builds agree regardless of SDK patch level. -->
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Windows-only APIs are intentional: the agent targets Windows management VMs. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Authors>FleetScope</Authors>
    <Product>FleetScope Agent</Product>
  </PropertyGroup>
</Project>
