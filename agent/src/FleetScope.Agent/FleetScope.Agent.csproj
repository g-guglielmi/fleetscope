<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>FleetScopeAgent</AssemblyName>
    <RootNamespace>FleetScope.Agent</RootNamespace>
    <Version>0.2.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Publish settings (single-file, self-contained win-x64) are passed on the
         command line by CI so this project can still be referenced by the tests. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="8.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FleetScope.Agent.Tests" />
  </ItemGroup>

</Project>
